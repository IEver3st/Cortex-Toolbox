# Main-process configuration. Copy to apps/desktop/.env.local for local overrides.
CORTEX_LOG_LEVEL=info
# stable | beta | development — beta packages use a separate app id, icon, and installer name
CORTEX_RELEASE_CHANNEL=development
CORTEX_GITHUB_OWNER=
CORTEX_GITHUB_REPOSITORY=
# Fine-grained GitHub token with repository Issues: Read and write permission.
# Keep this in apps/desktop/.env.local or the process environment. Never use VITE_.
CORTEX_GITHUB_REPORT_TOKEN=
# Optional comma-separated labels that already exist in the repository.
CORTEX_GITHUB_REPORT_LABELS=
CORTEX_ENABLE_AUTO_UPDATE=false
CORTEX_ENABLE_DEVTOOLS=false
# Public WorkOS client ID used by the desktop PKCE sign-in flow.
# Use the same client ID as WORKOS_CLIENT_ID in apps/cortex-cloud/.dev.vars.
# WORKOS_API_KEY is not used by this flow and must not be placed in desktop env.
CORTEX_WORKOS_CLIENT_ID=
# protocol uses cortex-toolbox://auth/callback. loopback returns through a
# self-closing local page and requires this WorkOS redirect first:
# http://127.0.0.1:*/auth/callback
CORTEX_WORKOS_CALLBACK_MODE=protocol
# URL of the Cortex Cloud Worker used for hosted AI, account, and billing.
# Leave blank when running only local desktop tools.
CORTEX_CLOUD_API_URL=
CORTEX_CONVERTER_DIRECTORY=
CORTEX_MAX_ARCHIVE_SIZE_MB=2048
CORTEX_MAX_IMPORT_FILE_SIZE_MB=1024
# Optional release-only Authenticode credentials. Never prefix secrets with VITE_.
CORTEX_WINDOWS_CERTIFICATE_FILE=
CORTEX_WINDOWS_CERTIFICATE_PASSWORD=
