{
  "name": "cortex",
  "version": "1.0.0",
  "private": true,
  "description": "Cortex ToolBox — Free tools for people who make things.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @cortex/desktop dev",
    "dev:beta": "pnpm --filter @cortex/desktop dev:beta",
    "build": "pnpm -r --if-present build",
    "icons": "pnpm --filter @cortex/desktop icons",
    "make": "pnpm --filter @cortex/desktop make",
    "make:beta": "pnpm --filter @cortex/desktop make:beta",
    "package": "pnpm --filter @cortex/desktop build",
    "package:beta": "pnpm --filter @cortex/desktop package:beta",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "node scripts/scan-public-source.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,css,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.21",
      "undici": "7.29.0",
      "ip-address": "10.3.1",
      "tmp": "0.2.7",
      "fast-uri": "3.1.5",
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@>=4.0.0": "5.0.9",
      "js-yaml@^3.0.0": "3.15.1",
      "js-yaml@^4.0.0": "4.3.1",
      "nanoid": "3.3.17",
      "postcss": "8.5.23"
    }
  }
}
