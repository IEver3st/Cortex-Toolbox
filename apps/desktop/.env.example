CORTEX_LOG_LEVEL=info
CORTEX_RELEASE_CHANNEL=development
CORTEX_GITHUB_OWNER=
CORTEX_GITHUB_REPOSITORY=
# Fine-grained GitHub token with Issues: Read and write for the repository above.
# Kept only in apps/desktop/.env.local or your process environment; never use VITE_.
CORTEX_GITHUB_REPORT_TOKEN=
# Optional comma-separated labels that already exist in the repository.
CORTEX_GITHUB_REPORT_LABELS=
CORTEX_ENABLE_AUTO_UPDATE=false
CORTEX_ENABLE_DEVTOOLS=false
CORTEX_WORKOS_CLIENT_ID=
# Set to loopback only after registering http://127.0.0.1:*/auth/callback in WorkOS.
CORTEX_WORKOS_CALLBACK_MODE=protocol
CORTEX_CLOUD_API_URL=
CORTEX_CONVERTER_DIRECTORY=
CORTEX_MAX_ARCHIVE_SIZE_MB=2048
CORTEX_MAX_IMPORT_FILE_SIZE_MB=1024
# Optional release-only Authenticode inputs. Keep the certificate and password
# in the owner shell or GitHub Actions secrets, never in a tracked env file.
CORTEX_WINDOWS_CERTIFICATE_FILE=
CORTEX_WINDOWS_CERTIFICATE_PASSWORD=
