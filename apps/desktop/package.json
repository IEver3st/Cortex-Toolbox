{
  "name": "@cortex/desktop",
  "productName": "Cortex ToolBox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "description": "Cortex ToolBox — Free tools for people who make things.",
  "author": "Cortex contributors",
  "scripts": {
    "icons": "node ./scripts/generate-icons.mjs",
    "dev": "electron-forge start",
    "dev:beta": "node ./scripts/with-channel.mjs beta electron-forge start",
    "build": "electron-forge package",
    "package:beta": "node ./scripts/with-channel.mjs beta electron-forge package",
    "make": "node ./scripts/with-channel.mjs stable electron-forge make",
    "make:beta": "node ./scripts/with-channel.mjs beta electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@cortex/core": "workspace:*",
    "@cortex/format-adapters": "workspace:*",
    "@cortex/plugin-sdk": "workspace:*",
    "@cortex/project-schema": "workspace:*",
    "@cortex/resource-parser": "workspace:*",
    "@cortex/script-analysis": "workspace:*",
    "@cortex/vehicle-meta": "workspace:*",
    "@electron-forge/plugin-vite": "7.11.2",
    "@radix-ui/react-dialog": "1.1.19",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-query": "5.101.2",
    "archiver": "8.0.0",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "electron-store": "11.0.2",
    "fast-glob": "3.3.3",
    "lucide-react": "1.24.0",
    "motion": "12.42.2",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-router-dom": "7.18.1",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "tailwindcss": "4.3.2",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-base": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@types/archiver": "8.0.0",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.0",
    "lodash": "4.17.23",
    "vite": "8.1.4"
  }
}
